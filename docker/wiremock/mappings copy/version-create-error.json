{
  "request": {
    "method": "POST",
    "urlPath": "/version",
    "bodyPatterns": [
      {"contains": "fecha_lanzamiento"},
      {"contains": "2024-12-01"}
    ]
  },
  "response": {
    "status": 422,
    "headers": {"Content-Type": "application/json"},
    "jsonBody": {"error_code":"VERSION_DATE_INVALID","message":"fecha_lanzamiento anterior a última versión"}
  }
}